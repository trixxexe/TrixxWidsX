    <string name="help_title">How to use TrixxWids</string>
    <string name="help_create_widget">Creating a Widget</string>
    <string name="help_create_widget_body">1. Open the Editor tab\n2. Select your widget size\n3. Tap Add buttons to place elements\n4. Drag and resize elements on the canvas\n5. Tap an element to edit its properties\n6. Save your widget when done</string>
    <string name="help_add_to_homescreen">Adding to Home Screen</string>
    <string name="help_add_to_homescreen_body">1. Go to My Widgets tab\n2. Tap the widget you want to add\n3. Tap "Apply to Home Screen"\n4. Follow the system prompts to place it\n5. If prompted, grant BIND_APPWIDGET permission</string>
    <string name="help_gyro_effect">Enabling the Gyro Effect</string>
    <string name="help_gyro_effect_body">1. Open the Editor tab\n2. Tap the gyro icon (the tilt icon)\n3. Toggle the switch to enable\n4. Tilt your device to see the parallax effect\nNote: Requires a device with a gyroscope sensor</string>
    <string name="help_faq">FAQ</string>
    <string name="help_faq_q1">Q: Why can\'t I add widgets to the lock screen?</string>
    <string name="help_faq_a1">A: Android restricts direct lock screen widget placement. You can use live wallpaper apps or notification widgets as alternatives.</string>
    <string name="help_faq_q2">Q: My widget isn\'t updating?</string>
    <string name="help_faq_a2">A: Make sure your widget is placed and try reopening the app. Some launchers may need a restart.</string>
    <string name="help_faq_q3">Q: Can I share my widgets?</string>
    <string name="help_faq_a3">A: Export/import feature coming in a future update!</string>
